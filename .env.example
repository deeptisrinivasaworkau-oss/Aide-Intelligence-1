# Copy to .env.local for local development, and set the same values in
# Netlify under Site configuration > Environment variables.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle. OAuth *client IDs*
# are public by design and safe there. Client secrets and API keys are not —
# keep those on the unprefixed variables below, which stay server-side.

# --- Dashboard connectors (browser) ---
# Google Cloud console > APIs & Services > Credentials > OAuth 2.0 Client ID
# (Web application). Add your site's origin as an authorised JavaScript origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Slack app > Basic Information > App Credentials > Client ID.
# Add https://<your-site>/api/slack-oauth as a redirect URL.
NEXT_PUBLIC_SLACK_CLIENT_ID=

# Azure > Entra ID > App registrations > Application (client) ID.
# Register as a Single-page application and add your site's URL as a redirect URI.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# --- Server-side secrets (never exposed to the browser) ---
# Same Slack app as above: Basic Information > App Credentials.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Powers the AI email summaries on /dashboard. Without it the dashboard falls
# back to its free client-side heuristic lines.
ANTHROPIC_API_KEY=

# --- Request storage (Try Aide + demonstration form) ---
# Create a Postgres database in Vercel: Storage > Create Database > Neon.
# Vercel injects DATABASE_URL automatically once it's connected to the project.
# Without it, both forms report honestly that the request was not saved.
DATABASE_URL=
